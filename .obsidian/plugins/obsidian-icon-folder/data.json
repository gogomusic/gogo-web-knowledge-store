{
  "settings": {
    "migrated": 6,
    "iconPacksPath": ".obsidian/icons",
    "fontSize": 16,
    "emojiStyle": "native",
    "iconColor": null,
    "recentlyUsedIcons": [
      "LiEdit",
      "LiVscodeLogo",
      "RiAndroidLine",
      "RiNextjsLine",
      "RiCss3Line"
    ],
    "recentlyUsedIconsSize": 5,
    "rules": [
      {
        "rule": ".md",
        "icon": "RiMarkdownFill",
        "for": "everything",
        "order": 0
      },
      {
        "rule": ".jpg|.png|.gif|.webp",
        "icon": "LiImage",
        "for": "everything",
        "order": 1
      },
      {
        "rule": ".ppt|.pptx",
        "icon": "RiFilePptFill",
        "for": "everything",
        "order": 2
      },
      {
        "rule": "html",
        "icon": "FabHtml5",
        "for": "everything",
        "order": 3
      }
    ],
    "extraMargin": {
      "top": 0,
      "right": 4,
      "bottom": 0,
      "left": 0
    },
    "iconInTabsEnabled": true,
    "iconInTitleEnabled": false,
    "iconInTitlePosition": "above",
    "iconInFrontmatterEnabled": false,
    "iconInFrontmatterFieldName": "icon",
    "iconColorInFrontmatterFieldName": "iconColor",
    "iconsBackgroundCheckEnabled": false,
    "iconsInNotesEnabled": true,
    "iconsInLinksEnabled": true,
    "iconIdentifier": ":",
    "lucideIconPackType": "native",
    "debugMode": false,
    "useInternalPlugins": false
  },
